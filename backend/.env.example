# Copy to backend/.env to override the defaults in app/core/config.py.
DATABASE_URL=mysql+pymysql://pantry:pantry@127.0.0.1:3307/pantry?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://pantry:pantry@127.0.0.1:3307/pantry_test?charset=utf8mb4
MIGRATE_DATABASE_URL=mysql+pymysql://pantry:pantry@127.0.0.1:3307/pantry_migrate?charset=utf8mb4
CORS_ORIGINS=["http://localhost:5173"]
# Signs session cookies. Use a long random value anywhere but local dev.
SECRET_KEY=dev-only-change-me-dev-only-change-me
# Set true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
